{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cognis",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["*/5 * * * *"] },
  "build": { "command": "worker-build --release" },
  "observability": { "enabled": true },
  "assets": { "directory": "../web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
        { "binding": "DB", "database_name": "cognis", "database_id": "6c7dd18a-d7da-406a-bfec-8b22724ff8f0", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "INGEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "APP_ENV": "production",
    "EMAIL_MODE": "disabled",
    "EMBEDDER": "workers-ai",
    "LLM_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "APP_URL": "https://cognis.sasisundhar2211.workers.dev"
  }
  // Optional secret (wrangler secret put): INSTAGRAM_OEMBED_TOKEN for Instagram posts and reels
}
