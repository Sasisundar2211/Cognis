{
  // Black-box test target. Built with the test-hooks feature (email capture endpoint). Never deploy.
  "name": "cognis-test",
  "main": "build-test/worker/shim.mjs",
  "compatibility_date": "2026-11-01",
  "build": { "command": "worker-build --release -d build-test --features test-hooks" },
  "assets": { "directory": "../web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "cognis-test", "database_id": "local-test", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 100000, "period": 60 } },
    { "name": "INGEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 100000, "period": 60 } }
  ],
  "vars": { "APP_ENV": "test", "EMAIL_MODE": "capture", "EMBEDDER": "test-hash", "APP_URL": "http://localhost:8788" }
}
