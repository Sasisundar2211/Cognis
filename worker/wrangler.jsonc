{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cognis",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cognis",
      // Replace with the id printed by `wrangler d1 create cognis`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "INGEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "APP_ENV": "production",
    "EMAIL_MODE": "disabled",
    "EMBEDDER": "workers-ai"
  }
  // Secrets (set with `wrangler secret put`): BETTER_AUTH_SECRET, BETTER_AUTH_URL, RESEND_API_KEY (optional)
}
