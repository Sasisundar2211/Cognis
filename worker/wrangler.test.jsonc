{
  "name": "cognis-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "cognis-test", "database_id": "test", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 10000, "period": 60 } },
    { "name": "INGEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 10000, "period": 60 } }
  ],
  "vars": {
    "APP_ENV": "test",
    "EMAIL_MODE": "capture",
    "EMBEDDER": "test-hash",
    "BETTER_AUTH_SECRET": "test-secret-not-for-production-0123456789abcdef",
    "BETTER_AUTH_URL": "http://localhost"
  }
}
